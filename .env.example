# The project runs in mock mode by default. Copy this file to .env only when
# you want to connect the legacy chain to real services.
AGENT_MODE=mock

# Local demo API server
HOST=127.0.0.1
PORT=8080

# OpenAI-compatible LLM provider. BASE_URL/API_KEY are the names used by the
# legacy modules; LLM_* aliases are also accepted by config/settings.py.
BASE_URL=https://example.com/v1/chat/completions
API_KEY=Bearer your-api-key
BOT_URL=https://example.com/v1/chat/completions
LLM_MODEL=your-model-or-endpoint-id

# Legacy Socket.IO gateway client scripts.
ENTRY_URL=http://127.0.0.1:8080

# Legacy NLU / Reject / Intent services.
NLU_URL=http://127.0.0.1:8009/chatnlu-server/v1
REJECT_URL=http://127.0.0.1:8007/reject-server/v1
INTENT_URL=http://127.0.0.1:8008/intent-server/v1

# Legacy service runtime.
REQUEST_TIMEOUT=5
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
FLASK_SERVER_PORT=8080
